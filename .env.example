# ==============================================================================
# A股量化特征工程与 Vibe-Trading AI 投研系统 - 环境变量统一配置模板
# 使用方法：复制本文件为 .env (cp .env.example .env) 并填入您的实际参数
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 聚源金融数据库 (Gildata / JYDB / Oracle 11g+) 连接凭据
# ------------------------------------------------------------------------------
JYDB_HOST=127.0.0.1
JYDB_PORT=1521
JYDB_SERVICE=JYDBTEST
JYDB_USER=your_jydb_username
JYDB_PASSWORD=your_jydb_password

# ------------------------------------------------------------------------------
# 2. Oracle Instant Client 动态链接库路径 (Thick 模式驱动依赖)
# ------------------------------------------------------------------------------
# Linux 示例: /opt/oracle/instantclient 或 /usr/lib/oracle/11.2/client64/lib
# macOS 示例: /Users/your_user/instantclient_19_8
LD_LIBRARY_PATH=/opt/oracle/instantclient

# ------------------------------------------------------------------------------
# 3. Ashare Web 看板服务与反向代理配置
# ------------------------------------------------------------------------------
# 本地看盘 Web 服务监听端口 (前端访问地址: http://localhost:8089)
ASHARE_PORT=8089

# 后端 Vibe-Trading 服务的代理目标地址 (server.py 会将 /api/ashare/* 和 /chat 请求动态转发至此)
VIBE_HOST=http://127.0.0.1:8899

# Vibe-Trading 服务间通信鉴权 Key (与 Vibe 服务端 API_AUTH_KEY 保持一致)
VIBE_API_KEY=vibe123456

# ------------------------------------------------------------------------------
# 4. Vibe-Trading 大语言模型 (LLM) 接口配置
# ------------------------------------------------------------------------------
# 兼容 OpenAI 标准的本地/云端模型接口 (如 vLLM, Ollama, DeepSeek, OpenAI)
PRIMARY_LLM_BASE_URL=http://127.0.0.1:62202/0d574b39/sync/v1
PRIMARY_LLM_MODEL=Qwen3.8-27B
PRIMARY_LLM_API_KEY=your_llm_api_key_here

# ------------------------------------------------------------------------------
# 5. 外部数据源 Token (选填，用于北向资金/两融等补充工具)
# ------------------------------------------------------------------------------
TUSHARE_TOKEN=your_tushare_token_here

